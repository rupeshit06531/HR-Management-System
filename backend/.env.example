# ============================================================
# HR MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================

# Environment
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=DEBUG

# Security
DJANGO_SECRET_KEY=change-this-in-real-environment

# Hosts
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS / CSRF
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# ============================================================
# DATABASE
# ============================================================

# Development default:
# django.db.backends.sqlite3

# Production / PostgreSQL:
# django.db.backends.postgresql

DJANGO_DATABASE_ENGINE=django.db.backends.sqlite3
DJANGO_DATABASE_NAME=
DJANGO_DATABASE_USER=
DJANGO_DATABASE_PASSWORD=
DJANGO_DATABASE_HOST=localhost
DJANGO_DATABASE_PORT=5432
DJANGO_DATABASE_CONN_MAX_AGE=60

# ============================================================
# INTERNATIONALIZATION
# ============================================================

DJANGO_TIME_ZONE=Asia/Kolkata

# ============================================================
# EMAIL
# ============================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HRMS <noreply@example.com>

# For an SMTP provider, use its official host/port and store the password
# in a local or deployment secret, never in source control.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
